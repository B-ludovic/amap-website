generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// UTILISATEUR //

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  address       String?
  role          UserRole  @default(MEMBER)
  
  emailVerified          Boolean   @default(false)
  emailVerifyToken       String?   @unique
  emailVerifyTokenExpiry DateTime?

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  tokenVersion     Int       @default(1)

  // Opposition à la lettre d'information. Le booléen porte l'état du jour, la
  // date porte la preuve : l'article 21 du RGPD demande de pouvoir montrer quand
  // l'opposition a été exercée, pas seulement qu'elle l'est.
  //
  // Aucun jeton de désabonnement stocké ici : le lien des emails est signé à la
  // volée (src/utils/unsubscribeToken.js). Une colonne de jetons aurait exigé
  // d'en semer un dans chaque ligne existante le jour de la migration, puis de
  // n'en oublier aucune à la création d'un compte — deux occasions de laisser un
  // adhérent sans lien valide.
  newsletterOptIn    Boolean   @default(true)
  newsletterOptOutAt DateTime?

  subscriptions       Subscription[]
  subscriptionRequests SubscriptionRequest[]
  shiftVolunteers     ShiftVolunteer[]
  newsletters         Newsletter[]
  recipes             Recipe[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  
  @@index([email])
  @@index([role])
  @@index([resetToken])
  @@index([emailVerifyToken])
}

enum UserRole {
  MEMBER      // Adhérent simple
  VOLUNTEER   // Bénévole (+ accès permanences)
  ADMIN       // Administrateur
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// DEMANDES D'ABONNEMENTS

model SubscriptionRequest {
  id            String   @id @default(uuid())
  
  userId        String?
  firstName     String
  lastName      String
  email         String
  phone         String
  
  type          SubscriptionType
  basketSize    BasketSize
  pricingType   PricingType  @default(NORMAL)
  paymentType   String       @default("1")

  message       String?  @db.Text
  
  status        RequestStatus @default(PENDING)
  adminNotes    String?  @db.Text
  processedAt   DateTime?
  processedBy   String?
  
  user          User?    @relation(fields: [userId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

enum RequestStatus {
  PENDING       // En attente de traitement
  IN_PROGRESS   // En cours de traitement
  APPROVED      // Approuvé → abonnement créé
  REJECTED      // Refusé
  ARCHIVED      // Archivé
}


// PRODUCTEUR //

model Producer {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  specialty   String?
  description String?  @db.Text
  image       String?
  isActive    Boolean  @default(true)
  isExample   Boolean  @default(false)

  // Fiche de la ferme, affichée sur la page publique des producteurs
  city            String?
  postalCode      String?
  distanceKm      Int?      // distance au point de retrait
  certification   ProducerCertification @default(NONE)
  farmDetailLabel String?   // « Surface », « Cheptel »…
  farmDetail      String?   // « 4 hectares · 2 serres froides »
  partnerSince    Int?      // année d'entrée dans l'AMAP

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

enum ProducerCertification {
  NONE        // aucune mention affichée
  ORGANIC     // Certifiée AB
  CONVERSION  // En conversion bio
}


// PRODUITS //

model Product {
  id          String       @id @default(uuid())
  name        String
  producerId  String
  category    ProductCategory?
  description String?      @db.Text
  image       String?
  isActive    Boolean      @default(true)
  isExample   Boolean      @default(false)
  seasons     Season[]     @default([])
  basketSizes BasketSize[] @default([SMALL, LARGE])

  producer    Producer    @relation(fields: [producerId], references: [id])

  weeklyBasketItems WeeklyBasketItem[]
  recipeProducts    RecipeProduct[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([producerId])
  @@index([category])
  @@index([isActive])
}

enum ProductCategory {
  VEGETABLES  // Légumes
  FRUITS      // Fruits
  EGGS        // Œufs
  GROCERY     // Épicerie (farine, pâtes, huile, lentilles)
}


// POINT DE RETRAIT //

model PickupLocation {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  postalCode  String
  
  schedule    String   @default("Mercredi 18h15 - 19h15")
  instructions String? @db.Text
  
  isActive    Boolean  @default(true)
  isExample   Boolean  @default(false)
  
  subscriptions Subscription[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// ABONNEMENTS //

model Subscription {
  id              String   @id @default(uuid())
  userId          String
  subscriptionNumber String @unique
  
  type            SubscriptionType
  basketSize      BasketSize
  pricingType     PricingType
  status          SubscriptionStatus @default(PENDING)
  
  startDate       DateTime
  endDate         DateTime
  
  price           Float
  paidAmount      Float    @default(0)
  
  pickupLocationId String
  
  user            User            @relation(fields: [userId], references: [id])
  pickupLocation  PickupLocation  @relation(fields: [pickupLocationId], references: [id])
  
  pickups         WeeklyPickup[]
  pauses          SubscriptionPause[]
  payments        Payment[]
  
  renewalReminderSentAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([pricingType])
  @@index([endDate])
}

enum SubscriptionType {
  ANNUAL      // Annuel (janvier → décembre)
  DISCOVERY   // Découverte (3 mois)
}

enum BasketSize {
  SMALL   // Petit panier (2-4 kg)
  LARGE   // Grand panier (6-8 kg)
}

enum PricingType {
  NORMAL      // Tarif normal (100%)
  SOLIDARITY  // Tarif solidaire (20% adhérent + 80% Secours Catholique)
}

enum SubscriptionStatus {
  PENDING     // En attente de paiement
  ACTIVE      // Actif
  PAUSED      // En pause
  EXPIRED     // Expiré
  CANCELLED   // Annulé
}


// PAUSES D'ABONNEMENT //

model SubscriptionPause {
  id              String   @id @default(uuid())
  subscriptionId  String
  startDate       DateTime
  endDate         DateTime
  reason          String?
  
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([subscriptionId])
}


// PAIEMENTS //

// Un chèque, et un seul. L'association encaisse par chèque : une ligne ici est
// un bout de papier qu'on peut tenir dans la main, pas une intention de payer.
// C'est pourquoi elle n'existe qu'à partir du moment où le trésorier l'a reçu,
// et pourquoi son statut décrit un lieu — la pochette, la banque, le compte —
// plutôt qu'un état abstrait.
model Payment {
  id                String   @id @default(uuid())
  subscriptionId    String
  amount            Float
  status            PaymentStatus @default(RECEIVED)

  // Relevé si le trésorier en a le temps, jamais exigé : on ne saisit pas un
  // numéro à sept chiffres debout devant une file d'attente.
  checkNumber       String?

  // receivedAt est la remise en main propre, createdAt la saisie. Elles
  // coïncident à une permanence, pas quand le pointage se fait le lendemain.
  receivedAt        DateTime

  // Dépôt prévu, déplaçable : une échéance est un plan, pas un engagement.
  dueDate           DateTime
  depositedAt       DateTime?
  paidAt            DateTime?

  // Garde anti-doublon de l'avis envoyé à l'adhérent avant l'encaissement, sur
  // le modèle de Subscription.renewalReminderSentAt.
  reminderSentAt    DateTime?

  // Même garde, côté trésorier. Deux colonnes et non une : les deux rappels ne
  // partent pas au même moment (30 jours avant pour l'adhérent, 7 jours avant
  // pour le dépôt) et l'un ne doit pas éteindre l'autre. Cette date-ci est
  // relevée à chaque relance, ce qui espace les rappels d'un chèque oublié.
  treasurerNotifiedAt DateTime?

  subscription      Subscription @relation(fields: [subscriptionId], references: [id])

  createdAt         DateTime @default(now())

  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

enum PaymentStatus {
  RECEIVED    // dans la pochette du trésorier
  DEPOSITED   // remis en banque, encaissement en attente
  SUCCEEDED   // encaissé
  FAILED      // rejeté, sans provision
  RETURNED    // rendu à l'adhérent, contrat annulé
}


// PANIER HEBDOMADAIRE //

model WeeklyBasket {
  id              String   @id @default(uuid())
  weekNumber      Int
  year            Int
  distributionDate DateTime
  season          Season?
  
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  
  notes           String?  @db.Text
  
  items           WeeklyBasketItem[]
  pickups         WeeklyPickup[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([year, weekNumber])
  @@index([distributionDate])
  @@index([isPublished])
}

model WeeklyBasketItem {
  id                String   @id @default(uuid())
  weeklyBasketId    String
  productId         String?
  customProductName String?
  basketSizes       BasketSize[] @default([SMALL, LARGE])

  weeklyBasket      WeeklyBasket  @relation(fields: [weeklyBasketId], references: [id], onDelete: Cascade)
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([weeklyBasketId])
  @@index([productId])
}


// RETRAITS EFFECTUÉS //

model WeeklyPickup {
  id              String   @id @default(uuid())
  subscriptionId  String
  weeklyBasketId  String
  pickupDate      DateTime
  
  wasPickedUp     Boolean  @default(false)
  pickedUpAt      DateTime?
  pickedUpBy      String?
  notes           String?
  
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  weeklyBasket    WeeklyBasket @relation(fields: [weeklyBasketId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@unique([subscriptionId, weeklyBasketId])
  @@index([weeklyBasketId])
  @@index([pickupDate])
}


// GESTION DES PERMANENCES //

model Shift {
  id                String   @id @default(uuid())
  distributionDate  DateTime
  startTime         String   @default("18:15")
  endTime           String   @default("19:15")
  volunteersNeeded  Int      @default(2)
  notes             String?  @db.Text
  
  volunteers        ShiftVolunteer[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([distributionDate])
}

model ShiftVolunteer {
  id        String   @id @default(uuid())
  shiftId   String
  userId    String
  role      String?
  status    VolunteerStatus @default(CONFIRMED)
  
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([shiftId, userId])
  @@index([userId])
}

enum VolunteerStatus {
  CONFIRMED
  CANCELLED
  ABSENT
}


// NEWSLETTER / COMMUNICATION //

model Newsletter {
  id          String   @id @default(uuid())
  subject     String
  content     String   @db.Text
  type        NewsletterType @default(GENERAL)
  target      NewsletterTarget @default(ALL)
  
  scheduledFor DateTime?

  // Où en est l'envoi. Le champ existe parce qu'un envoi ne se fait plus dans
  // la requête de l'administratrice : elle reçoit un 202 aussitôt le drapeau
  // pris, et c'est ici qu'elle lit ensuite ce qu'il est advenu.
  //
  // sentAt seul ne pouvait pas porter cette information : posé, il disait
  // « envoyée » aussi bien pour un envoi terminé que pour un envoi encore en
  // cours ; nul, il ne distinguait pas un brouillon jamais lancé d'une
  // tentative qui n'a atteint personne. Trois états valent mieux que deux
  // valeurs d'un même champ.
  status      NewsletterStatus @default(DRAFT)

  // Début de l'envoi, pas sa fin : il est posé au moment où la newsletter est
  // réservée, et c'est ce début qui fait foi pour refuser un second départ.
  sentAt      DateTime?
  sentCount   Int      @default(0)

  // Le pendant de sentCount, sans lequel un envoi partiel ressemble trait pour
  // trait à un envoi complet : le relais refuse au-delà de son quota du jour,
  // la moitié de la liste reste sur le carreau, et l'écran affiche « Envoyée »
  // suivi du seul compte des réussites. Le détail par destinataire est dans
  // EmailLog ; ce compteur est là pour qu'on ait une raison d'aller l'y lire.
  failedCount Int      @default(0)


  // L'auteur signe la newsletter, il ne la possède pas : l'archive de
  // communication de l'association survit au départ du bénévole qui l'a écrite.
  // La purge RGPD coupe le lien nominatif, la base ne détruit pas le contenu.
  createdBy   String?
  author      User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([sentAt])
  @@index([createdBy])
  @@index([status])
}

/* DRAFT rien n'est parti, SENDING la boucle tourne, SENT au moins une boîte a
   reçu, FAILED aucune.

   FAILED n'est pas une impasse : c'est un état de départ au même titre que
   DRAFT, et la prise du drapeau accepte les deux. Un quota Brevo dépassé un
   matin ne condamne donc pas le texte — il dit seulement que la tentative
   précédente n'a atteint personne. */
enum NewsletterStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum NewsletterType {
  GENERAL
  WEEKLY_BASKET
  RECIPE
  ALERT
  PRODUCER_NEWS
}

enum NewsletterTarget {
  ALL
  ACTIVE_SUBSCRIBERS
  SOLIDARITY
  TEST
}


// RECETTES DE CUISINE //

model Recipe {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  ingredients String   @db.Text
  steps       String   @db.Text
  
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  difficulty  RecipeDifficulty? @default(EASY)
  season      Season?
  
  image       String?
  tips        String?  @db.Text
  
  // Même règle que pour la newsletter : la recette appartient au site, pas à
  // celui qui l'a saisie. Perdre son auteur ne doit pas la faire disparaître des
  // pages publiques, ni emporter ses RecipeProduct en cascade.
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  products    RecipeProduct[]
  
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  
  viewCount   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([season])
  @@index([isPublished])
}

model RecipeProduct {
  id         String  @id @default(uuid())
  recipeId   String
  productId  String
  quantity   String
  isOptional Boolean @default(false)
  
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([recipeId])
  @@index([productId])
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}


// DEMANDES PRODUCTEURS //

model ProducerInquiry {
  id            String   @id @default(uuid())
  
  firstName     String
  lastName      String
  email         String
  phone         String
  
  farmName      String
  address       String
  city          String
  postalCode    String
  distance      Int?
  
  products      String   @db.Text
  isBio         Boolean  @default(false)
  certifications String?  @db.Text
  
  message       String?  @db.Text
  availability  String?
  
  status        InquiryStatus @default(PENDING)
  adminNotes    String?  @db.Text
  respondedAt   DateTime?
  respondedBy   String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  ACCEPTED
  REJECTED
  ARCHIVED
}


// FERMETURE AMAP //

model AmapClosure {
  id        String   @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startDate])
}


// JOURNAL D'AUDIT //

model AuditLog {
  id          String   @id @default(uuid())

  adminId     String?
  adminEmail  String

  action      AuditAction
  severity    AuditSeverity

  targetType  String?
  targetId    String?
  targetLabel String?

  details     Json?

  ipAddress   String?

  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
}

enum AuditAction {
  // Critique
  DELETE_USER
  CHANGE_USER_ROLE
  PURGE_USER_DATA
  // Écrire à tout le monde au nom de l'association : l'acte le plus visible que
  // l'application permette, et le seul qui sorte du site pour atteindre des
  // boîtes aux lettres. Il ne se rattrape pas.
  SEND_NEWSLETTER
  // Importante
  CREATE_PRODUCER
  UPDATE_PRODUCER
  DELETE_PRODUCER
  CREATE_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  UPDATE_THEME
  DELETE_NEWSLETTER
  DELETE_CONTACT_MESSAGE
  DELETE_PRODUCER_INQUIRY
  DELETE_EXAMPLES
  APPROVE_SUBSCRIPTION_REQUEST
  REJECT_SUBSCRIPTION_REQUEST
  CREATE_SUBSCRIPTION
  UPDATE_SUBSCRIPTION
  ACTIVATE_SUBSCRIPTION
  CANCEL_SUBSCRIPTION
  PAUSE_SUBSCRIPTION
  RESUME_SUBSCRIPTION
  UPDATE_SUBSCRIPTION_STATUS
  CREATE_SHIFT
  UPDATE_SHIFT
  DELETE_SHIFT
  UPDATE_SHIFT_VOLUNTEER_STATUS
  CREATE_WEEKLY_BASKET
  UPDATE_WEEKLY_BASKET
  DELETE_WEEKLY_BASKET
  PUBLISH_WEEKLY_BASKET
  CREATE_CLOSURE
  UPDATE_CLOSURE
  DELETE_CLOSURE
  UPDATE_WEEKLY_PICKUP
  EXPORT_DISTRIBUTION_LIST
  // Critique — de l'argent entre en base, ou en sort
  RECORD_CHEQUES_RECEIVED
  UPDATE_PAYMENT_STATUS
  FAILED_PAYMENT_REAUTH
}

enum AuditSeverity {
  CRITICAL
  IMPORTANT
}


// THÈME SAISONNIER (Existant - conservé) //

model ThemeConfig {
  id              String  @id @default(uuid())
  season          Season  @unique
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  backgroundImage String?
  isActive        Boolean @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// TRACE DES EMAILS //

/* Ce que le site a réellement posté, et ce qu'il n'a pas réussi à poster.

   La question qui a fait naître cette table : « l'adhérente Machin a-t-elle reçu
   sa confirmation le 12 mars ? ». AuditLog enregistre l'acte administratif —
   l'abonnement approuvé — jamais le sort du message parti derrière. Les logs de
   l'hébergeur tournent et personne n'ouvre le tableau de bord Brevo. Sans cette
   table, la réponse honnête était : on ne sait pas.

   On n'y garde que l'enveloppe, jamais le corps du message. Le HTML rendu
   contient le prénom, l'adresse de retrait, le contenu du panier — le conserver
   reviendrait à tenir une copie de la boîte mail de chaque adhérent. Le
   destinataire, le sujet et le sort de l'envoi suffisent à répondre à la
   question ; le reste se relit dans le gabarit. */

model EmailLog {
  id        String   @id @default(uuid())

  kind      EmailKind
  // L'objet métier concerné — la permanence, le contrat, la candidature —
  // quand il y en a un. Volontairement sans relation ni contrainte : la trace
  // doit survivre à la purge de ce qu'elle décrit, sinon la preuve qu'on a
  // prévenu quelqu'un disparaîtrait avec la permanence annulée.
  ref       String?

  to        String
  subject   String

  status    EmailStatus
  messageId String?
  error     String?  @db.Text

  sentAt    DateTime @default(now())

  @@index([to])
  @@index([kind])
  @@index([status])
  @@index([sentAt])
}

enum EmailStatus {
  SENT
  FAILED
}

// Un membre par expéditeur du service. L'énumération plutôt qu'une chaîne
// libre : une faute de frappe dans un kind rendrait la ligne introuvable au
// moment précis où on la cherche.
enum EmailKind {
  WELCOME
  EMAIL_VERIFICATION
  ACCOUNT_ALREADY_EXISTS
  PASSWORD_RESET
  SUBSCRIPTION_REQUEST_CONFIRMATION
  SUBSCRIPTION_CONFIRMATION
  RENEWAL_REMINDER
  SUBSCRIPTION_CANCELLATION
  CHEQUE_DEPOSIT_NOTICE
  TREASURER_CHEQUE_DIGEST
  SHIFT_CONFIRMATION
  SHIFT_CANCELLATION
  SHIFT_WITHDRAWAL
  WEEKLY_BASKET
  NEWSLETTER
  PRODUCER_INQUIRY_CONFIRMATION
  PRODUCER_INQUIRY_ACCEPTED
  PRODUCER_INQUIRY_REJECTED
  CONTACT_MESSAGE
}
