DATABASE_URL="postgresql://user:password@localhost:5432/aux_ptits_pois"
PORT=4000
NODE_ENV=development
JWT_SECRET="ton-secret-jwt"
JWT_EXPIRE="7d"
# Envoi des emails transactionnels via le relais SMTP de Brevo.
# Tableau de bord Brevo : Transactional > SMTP Settings (ou Settings > SMTP & API).
# BREVO_SMTP_USER est le login dédié, de la forme xxxxx@smtp-brevo.com : ni
# l'adresse de ton compte Brevo, ni smtp-relay.brevo.com qui est le serveur.
# BREVO_SMTP_KEY est une clé SMTP, PAS une clé API (xkeysib-...) : les deux sont
# affichées sur la même page et l'API ne s'authentifie pas en SMTP.
# Une clé n'est lisible en entier qu'à sa création ; sinon, en générer une neuve.
BREVO_SMTP_USER="xxxxx@smtp-brevo.com"
BREVO_SMTP_KEY="ta-cle-smtp-brevo"
EMAIL_FROM="noreply@auxptitspois.com"
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"