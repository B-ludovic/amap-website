DATABASE_URL="postgresql://user:password@localhost:5432/aux_ptits_pois"
PORT=4000
NODE_ENV=development
# Aucune valeur de repli dans le code : sans ce secret, le serveur refuse de
# démarrer (src/config/env.js). C'est voulu — un repli silencieux rendrait tous
# les jetons forgeables.
JWT_SECRET="ton-secret-jwt"
# Envoi des emails transactionnels via le relais SMTP de Brevo.
# Tableau de bord Brevo : Transactional > SMTP Settings (ou Settings > SMTP & API).
# BREVO_SMTP_USER est le login dédié, de la forme xxxxx@smtp-brevo.com : ni
# l'adresse de ton compte Brevo, ni smtp-relay.brevo.com qui est le serveur.
# BREVO_SMTP_KEY est une clé SMTP, PAS une clé API (xkeysib-...) : les deux sont
# affichées sur la même page et l'API ne s'authentifie pas en SMTP.
# Une clé n'est lisible en entier qu'à sa création ; sinon, en générer une neuve.
BREVO_SMTP_USER="xxxxx@smtp-brevo.com"
BREVO_SMTP_KEY="ta-cle-smtp-brevo"
EMAIL_FROM="noreply@auxptitspois.com"
# Boîte du trésorier : c'est là qu'arrive le récapitulatif des chèques à porter
# à la banque. Une vraie adresse relevée, pas une adresse d'envoi.
TREASURER_EMAIL="tresorerie@auxptitspois.fr"
# Origine du site, utilisée à la fois pour les liens des emails et pour la liste
# CORS. Les autres origines autorisées sont écrites en dur dans src/server.js :
# il n'y a pas de variable pour en ajouter une.
FRONTEND_URL="http://localhost:3000"

# --- Facultatives : ne les poser que si le cas se présente ---

# Adresse publique de cette API, terminaison /api comprise. Elle ne sert qu'aux
# en-têtes de désabonnement des newsletters : Gmail et Yahoo affichent leur
# propre bouton « Se désabonner » à côté de l'expéditeur et postent dessus sans
# que le message soit ouvert (RFC 8058), ce qui exige une adresse qui réponde à
# un POST — l'API, donc, pas le site Next.js.
# Sans elle, l'en-tête retombe sur la page /desabonnement du site : le clic ouvre
# un navigateur au lieu de désabonner sur place. Le lien du pied de page, lui,
# fonctionne dans tous les cas. Voir src/utils/unsubscribeToken.js.
# PUBLIC_API_URL="https://api.auxptitspois.fr/api"

# Chromium démarre avec son bac à sable et se replie tout seul si l'hébergeur le
# refuse, en l'écrivant dans les logs. Poser « true » sur un hébergeur dont on
# sait déjà qu'il le refuse, pour éviter une tentative perdue avant chaque
# contrat PDF. Voir src/services/contract.service.js.
# PUPPETEER_DISABLE_SANDBOX=true

# Déclaration explicite qu'un jeton anti-CSRF a été mis en place. Sans elle, le
# serveur refuse de démarrer si le cookie d'authentification quitte
# SameSite=Lax, qui est aujourd'hui la seule protection anti-CSRF de
# l'application. Voir src/controllers/auth.controller.js.
# CSRF_TOKEN_ENABLED=true